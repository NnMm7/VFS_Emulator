@echo off
REM Запуск тестов этапа 2 (Конфигурация)
cd /d "%~dp0"

echo   ТЕСТ 1: базовые команды из скрипта
python emulator.py --script .\test_cmds.sh

echo.
echo   ТЕСТ 2: скрипт с ошибками (пропускаются)
python emulator.py --script .\test_errors.sh

echo.
echo   ТЕСТ 3: отладочный вывод с --vfs
python emulator.py --vfs .\some_vfs_path --script .\test_cmds.sh

echo.
echo Тесты запущены. Закройте окно эмулятора вручную.
pause

# Запуск
run_tests.bat

# Или вручную
python emulator.py --script test_cmds.sh
python emulator.py --script test_errors.sh
python emulator.py --vfs ./some_path --script test_cmds.sh
